{
  "name": "aar-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000 --webpack",
    "dev:alt": "next dev --hostname 0.0.0.0 --port 43123 --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "start:alt": "next start --hostname 0.0.0.0 --port 43123",
    "serve": "npm run build && npm run start",
    "serve:alt": "npm run build && npm run start:alt",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
